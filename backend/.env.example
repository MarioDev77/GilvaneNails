# Database
DATABASE_URL="postgresql://gilvane:gilvane_secret@localhost:5432/gilvane_nails?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="generate-a-strong-secret-here-use-openssl-rand-base64-32"

# Optional: for production
# NODE_ENV=production

# Agenda online (opcional): e-mail da conta dona da agenda pública.
# Se vazio, usa a conta mais antiga cadastrada.
# PUBLIC_BOOKING_OWNER_EMAIL="voce@email.com"

# Aviso para a dona (opcional): chega no celular quando entra pedido, remarcação ou cancelamento.
# Pode ligar um canal, os dois ou nenhum. Sem nada configurado, não avisa (o sistema funciona igual).
# Telegram (grátis): crie um bot no @BotFather e pegue o chat id da conversa com ele.
# TELEGRAM_BOT_TOKEN="123456:ABC..."
# TELEGRAM_CHAT_ID="123456789"
# E-mail via Resend (resend.com): com o remetente padrão, só envia para o e-mail da própria conta Resend.
# RESEND_API_KEY="re_..."
# NOTIFY_EMAIL="gilvane@email.com"
# NOTIFY_EMAIL_FROM="Gilvane Nails <onboarding@resend.dev>"
# Endereço do painel, incluído no aviso (opcional)
# PANEL_URL="https://gilvane-nails.vercel.app"
