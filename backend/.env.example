# Banco de dados (o docker-compose.yml sobe um PostgreSQL com estes dados)
DATABASE_URL="postgresql://gilvane:gilvane_secret@localhost:5432/gilvane_nails"

# Login (NextAuth).
# NEXTAUTH_URL = endereço onde a pessoa ABRE o sistema (o do FRONTEND), não o do backend.
NEXTAUTH_URL="http://localhost:3000"
# Gere um segredo forte com:  openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-segredo-forte"
